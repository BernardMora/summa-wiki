{
  "name": "bernis-wiki",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local reader/editor for the AIOS knowledge base",
  "bin": {
    "wiki": "./bin/wiki"
  },
  "scripts": {
    "dev": "UV_THREADPOOL_SIZE=64 node --experimental-strip-types --no-warnings server.ts",
    "build": "NEXT_BUILD_DIR=.next-build next build",
    "start": "NEXT_BUILD_DIR=.next-build next start -p 4321",
    "wiki": "node --experimental-strip-types --no-warnings src/cli.ts",
    "index": "node --experimental-strip-types --no-warnings src/cli.ts index",
    "health": "node --experimental-strip-types --no-warnings src/cli.ts health",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.7",
    "next": "^15.1.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
